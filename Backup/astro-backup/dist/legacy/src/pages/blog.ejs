        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', 'G-MSX3GD41Z0');
    </script>
    <script data-goatcounter="https://danielkarasani01.goatcounter.com/count" async="" src="//gc.zgo.at/count.js"></script>

    
    <style id="critical-path-css">
:root {
    --bg-main: #fcfaf8;       
    --bg-hero: #ece6dd;       
    --text-dark: #2c2420;     
    --text-muted: #5a4f48;    
    --accent: #c89b72;        
    --accent-hover: #b3855c;  
    --white: #ffffff;
    --nav-bg: rgba(252, 250, 248, 0.7); 
    --gradient-text: linear-gradient(135deg, var(--text-dark), var(--accent));
}
body.dark-theme, html.dark-theme body {
    --bg-main: #1a1512;       
    --bg-hero: #241e1a;       
    --text-dark: #fcfaf8;     
    --text-muted: #b5a89f;    
    --accent: #d8b08d;        
    --white: #241e1a;         
    --nav-bg: rgba(26, 21, 18, 0.85); 
}
body {
    background-color: var(--bg-main);
    color: var(--text-dark);
}

</style>
    <link rel="stylesheet" href="styles.css">
    <script src="script.js" defer=""></script>
    <script>
        if (localStorage.getItem('theme') === 'dark') document.documentElement.className += ' dark-theme';
        if (sessionStorage.getItem('preloader-completed') === 'true') {
            document.documentElement.classList.add('preloader-skipped');
            document.write('<style>#preloader { display: none !important; }</style>');
        }
    </script>
    <noscript>
        <style>
            #preloader { display: none !important; }
            .reveal { opacity: 1 !important; transform: translateY(0) !important; }
            .cursor-dot, .cursor-outline { display: none !important; }
            * { cursor: auto !important; }
            a, button, input, textarea { cursor: pointer !important; }

            /* Mobile Navigation Fallback when JS is disabled */
            @media (max-width: 990px) {
                .nav-links {
                    position: static !important;
                    display: flex !important;
                    flex-direction: row !important;
                    flex-wrap: wrap !important;
                    justify-content: center !important;
                    gap: 15px !important;
                    transform: none !important;
                    opacity: 1 !important;
                    pointer-events: auto !important;
                    height: auto !important;
                    padding: 10px 0 !important;
                    background: transparent !important;
                    backdrop-filter: none !important;
                }
                .nav-links li {
                    width: auto !important;
                    opacity: 1 !important;
                    transform: none !important;
                }
                .nav-links a {
                    font-size: 1rem !important;
                    padding: 5px 10px !important;
                }
                .nav-container {
                    flex-direction: column !important;
                    gap: 10px !important;
                    padding: 10px 20px !important;
                }
                nav {
                    position: static !important;
                    padding: 10px 0 !important;
                }
                .hero {
                    padding-top: 40px !important;
                }
                #theme-toggle {
                    display: none !important;
                }
            }
        </style>
    </noscript>
</head>

<body>
    <script>
        if (localStorage.getItem('theme') === 'dark') document.body.classList.add('dark-theme');
    </script>

    

    <!-- Custom Cursor -->
    <div class="cursor-dot"></div>
    <div class="cursor-outline"></div>

    
<%- include('../components/nav', { lang, page }) %>


    <section class="hero case-study-hero">
        <div class="container reveal">
            <span class="tagline">Engineering Insights &amp; Research</span>
            <h1>The Logic Log</h1>
            <p class="quote">Documenting the intersection of systems, hardware, and strategy.</p>
        </div>
    </section>

    <!-- Blog Grid Section -->
    <section class="container reveal" style="margin-top: -60px; position: relative; z-index: 10;">
        <div class="blog-controls-wrapper">
            <div class="blog-search-box hover-target">
                <input type="text" id="blogSearchInput" placeholder="Search articles...">
                <span class="search-icon">🔍</span>
            </div>
            <div class="blog-sort-box">
                <label for="blogSortSelect">Sort by:</label>
                <select id="blogSortSelect" class="blog-sort-select hover-target">
                    <option value="default">Default (Manual)</option>
                    <option value="newest">Newest First</option>
                    <option value="oldest">Oldest First</option>
                    <option value="az">Alphabetical (A-Z)</option>
                    <option value="za">Alphabetical (Z-A)</option>
                </select>
            </div>
        </div>
        <div class="blog-grid">
            <noscript>
                <a href="posts/welcome-to-browser-markdown-editor.md" class="blog-card hover-target" target="_blank" rel="noopener noreferrer"><span class="blog-date">May 19, 2026</span>
                    <h3>Welcome to Browser Markdown Editor!</h3>
                    <p>New markdown editor</p>
                    <span class="project-link">Read Article <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg></span></a><a href="posts/direct-publishing-integration-test.md" class="blog-card hover-target" target="_blank" rel="noopener noreferrer"><span class="blog-date">May 19, 2026</span>
                    <h3>Direct Publishing Integration Test</h3>
                    <p>This is a live test post verifying the newly integrated GitHub client-side direct publishing pipeline.</p>
                    <span class="project-link">Read Article <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg></span></a>
                

                <a href="posts/my-first-post.md" class="blog-card hover-target" target="_blank" rel="noopener noreferrer">
                    <span class="blog-date">May 15, 2026</span>
                    <h3>The Business Case for AR in Maintenance</h3>
                    <p>Exploring how integrating Augmented Reality with AI and Condition Monitoring reduces operational
                        downtime in food manufacturing.</p>
                    <span class="project-link">Read Article <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg></span>
                </a>
            </noscript>
        </div>
    </section>

    <!-- Post Detail Modal -->
    <div id="blog-modal" class="blog-modal">
        <div class="modal-content hover-target">
            <button class="close-modal hover-target" onclick="closePost()">×</button>
            <div id="md-reader">Loading...</div>
        </div>
    </div>

    
<%- include('../components/footer', { lang, page }) %>


    <!-- Marked Library for Markdown Parsing -->
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

    
</body></html>

